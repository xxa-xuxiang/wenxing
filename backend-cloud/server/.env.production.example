# ============================================================
# 问星后端——生产环境配置模板
# 用法：复制为 backend-cloud/server/.env，逐项替换 <> 后再启动
# 严禁把本文件改名成 .env 直接上线；.env 已被 git 忽略
# ============================================================

NODE_ENV=production

# --- 监听 ---
PORT=3001
# 置于 Nginx 之后只监听本机
HOST=127.0.0.1
# 必须为 1，并让 Nginx 用 $remote_addr 覆盖 X-Forwarded-For，否则全局限流会串桶
TRUST_PROXY=1
# 全局限流：次/分钟/IP（多人共用 NAT 出口时可调高）
GLOBAL_RATE_MAX=600

# --- 数据库 ---
# SQLite 单文件，相对 server/prisma 解析；文件实际落在 backend-cloud/data/
DATABASE_URL="file:../../data/wenxing.db"
# 可选：把数据根换到独立挂载盘（同时要改 systemd 的 ReadWritePaths）
# WENXING_DATA_ROOT=/var/lib/wenxing/data

# --- 密钥（全部必填，且必须互不相同）---
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<64位随机十六进制>
# 平台 AI Key 的加密主密钥（更换后已保存的 Key 需在管理后台重新录入）
AI_KEY_ENC_SECRET=<另一个64位随机十六进制>

# --- AI 服务（也可全部留空，改为在管理后台录入）---
# 留空且后台未配置 Key 时，AI 相关接口会明确报错，不会静默降级
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000

# --- 管理后台（强口令 + 独立密钥）---
ADMIN_USERNAME=<管理员账号>
# 至少 16 位、含大小写/数字/符号，且不要包含 admin/wenxing 等字面
ADMIN_PASSWORD=<强随机口令>
# 必须与 JWT_SECRET 不同
ADMIN_JWT_SECRET=<第三个64位随机十六进制>
ADMIN_JWT_TTL=12h

# --- 跨域白名单 ---
# 同源部署（Nginx 反代 /api）可留空；桌面端用 / 移动端用独立域名时必须列出
# CORS_ORIGINS=https://app.example.com,https://h5.example.com,https://admin.example.com
CORS_ORIGINS=

# --- 向量检索（可选；留空则降级为本地哈希嵌入）---
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# --- 题库生产管线 ---
QUESTION_TARGET_PER_LEAF=20
FILL_CONCURRENCY=3
PIPELINE_BATCH_CONCURRENCY=3
DEDUP_COSINE=0.92
PIPELINE_SLEEP_MS=120

# --- 公开语料抓取白名单（只允许这些域名，遵守 robots 与限速）---
CORPUS_ALLOWED_DOMAINS=developer.mozilla.org,zh.wikipedia.org,wikipedia.org,www.runoob.com,www.w3cschool.cn,learn.microsoft.com,docs.python.org,nodejs.org,zh.cppreference.com,www.iso.org,openstd.samr.gov.cn,www.gov.cn,www.stats.gov.cn,www.mohurd.gov.cn,www.miit.gov.cn,www.nhc.gov.cn,www.moe.gov.cn,www.pbc.gov.cn,www.csrc.gov.cn,www.cbirc.gov.cn
CORPUS_FETCH_PER_LEAF=3
CORPUS_FETCH_TIMEOUT_MS=15000

# --- 日志 ---
# debug | info | warn | error
LOG_LEVEL=info
