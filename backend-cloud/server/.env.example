# 问星后端配置模板：复制本文件为 server/.env 后填入真实值
# .env 已在忽略规则中（根 .gitignore 与 server/.gitignore），不会入库

# DeepSeek 官方 API（OpenAI 兼容协议）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

PORT=3001
# 监听地址：0.0.0.0 供局域网/桌面端直连；生产置于 Nginx 之后建议 127.0.0.1
HOST=0.0.0.0
# 数据根统一为 backend-cloud/data（相对 prisma/schema.prisma 解析）
DATABASE_URL="file:../../data/wenxing.db"
# 可选：数据根覆盖（默认按 lib/data-root.js 解析到 backend-cloud/data；桌面端打包由 Tauri 传入绝对路径）
# WENXING_DATA_ROOT=
# 生产环境务必替换为足够长的随机串（至少 32 位），留空则后端拒绝启动
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-please-use-64-hex-chars-generated-randomly"
# 平台 AI Key 的加密主密钥（至少 32 位，不得与 JWT_SECRET 相同；更换后已保存的 Key 需重新录入）
AI_KEY_ENC_SECRET=""
# CORS 额外白名单（逗号分隔；本机/局域网/Tauri 源已内置）
# CORS_ORIGINS=https://example.com
# 反向代理层数（部署在 Nginx 等代理后按需设置，默认 false）
# 生产必须设为 1，并让代理用真实客户端 IP 覆盖 X-Forwarded-For，否则全局限流会串成一个桶
# TRUST_PROXY=1
# 全局接口限流（次/分钟/IP，默认 600；多人共用出口 NAT 时按需调高）
# GLOBAL_RATE_MAX=600

# 文档向量库 Embedding（OpenAI 兼容协议，任一支持 /embeddings 的服务商均可；
# 不配置时检索自动降级为本地 512 维哈希嵌入，语义检索/题目去重质量略降但链路不断）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== 题库生产管线（v1.1） =====
# 每个技能叶子的目标题量
QUESTION_TARGET_PER_LEAF=20
# 填充 worker 并发（建议 2-4，过高易触发限流）
FILL_CONCURRENCY=3
# 批次内并发上限与批次间隔（毫秒）
PIPELINE_BATCH_CONCURRENCY=3
PIPELINE_SLEEP_MS=120
# 题目去重余弦阈值（越大越严格）
DEDUP_COSINE=0.92
# 单次 AI 调用超时（毫秒）
DEEPSEEK_TIMEOUT_MS=120000
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# 书籍远程下载白名单（逗号分隔；默认内置常用公开书库域名，留空表示仅内置）
# BOOK_ALLOWED_DOMAINS=gutenberg.org,www.gutenberg.org,archive.org
# 公开语料抓取白名单域名（逗号分隔；仅抓取这些域名下的页面，遵守 robots 与限速）
# 默认偏许可友好：官方文档 / 百科（CC，部分网络不可达时代码自动跳过）/ 公开标准与政府资料
# 发现通道另用 Bing（cn.bing.com，仅作站内搜索，落地页仍必须在本白名单内），无需在此加入
CORPUS_ALLOWED_DOMAINS=developer.mozilla.org,zh.wikipedia.org,wikipedia.org,www.runoob.com,www.w3cschool.cn,learn.microsoft.com,docs.python.org,nodejs.org,zh.cppreference.com,www.iso.org,openstd.samr.gov.cn,www.gov.cn,www.stats.gov.cn,www.mohurd.gov.cn,www.miit.gov.cn,www.nhc.gov.cn,www.moe.gov.cn,www.pbc.gov.cn,www.csrc.gov.cn,www.cbirc.gov.cn
# 每个叶子语料不足时的抓取尝试上限与单页抓取超时（毫秒）
CORPUS_FETCH_PER_LEAF=3
CORPUS_FETCH_TIMEOUT_MS=15000

# ===== 管理后台（仅本机/内网） =====
ADMIN_USERNAME=admin
# 强密码（≥12 位）；与 ADMIN_JWT_SECRET 一起留空可禁用管理后台
ADMIN_PASSWORD=
# 独立的随机长串（≥32 位，且不得与 JWT_SECRET 相同），已配置管理员账号时必须填写
ADMIN_JWT_SECRET=
ADMIN_JWT_TTL=12h
