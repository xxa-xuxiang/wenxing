{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wenxing",
  "version": "../package.json",
  "identifier": "com.wenxing.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "问星",
    "copyright": "Copyright © 2026 问星",
    "category": "Education",
    "shortDescription": "问星 · AI 学习伴侣",
    "longDescription": "问星是一款 AI 学习伴侣，支持知识星图、AI 问答、题库练习与学习社区。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
